rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == "8lzUiIaIsfcCVsXmIAgkcLsNwVc2";
    }
    // Datos públicos de la portada: cualquiera puede leerlos, solo la organización los escribe.
    match /publico/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /jugadas/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Todo lo demás (equipos, inscripciones, pagos, gastos, configuración, cuadro): solo la organización.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
